---
import { readdirSync, statSync } from 'fs'
import { join } from 'node:path'

export function getStaticPaths() {
  const publicDir = join(process.cwd(), 'public')
  const entries = readdirSync(publicDir, { withFileTypes: true })
  return entries
    .filter(e => e.isDirectory())
    .map(e => ({ params: { dir: e.name } }))
}

const { dir } = Astro.params
const dirPath = join(process.cwd(), 'public', dir)

try {
  statSync(dirPath)
} catch {
  return Astro.redirect('/404')
}

const files = readdirSync(dirPath)
  .filter(f => !f.startsWith('.') && /\.(avif|webp|png|jpg|jpeg|gif|svg|bmp|ico)$/i.test(f))
  .sort((a, b) => {
    const na = a.replace(/\D/g, '')
    const nb = b.replace(/\D/g, '')
    return Number(na) - Number(nb)
  })

const basePath = `/${dir}`
---

<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>目录 {dir} - 图片</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: #fafafa;
      color: #333;
      min-height: 100vh;
    }
    header {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 24px 20px;
      border-bottom: 1px solid #eee;
      background: #fff;
    }
    .back {
      font-size: 1.2rem;
      color: #666;
      text-decoration: none;
      padding: 4px 8px;
    }
    .back:hover { color: #000 }
    header h1 {
      font-size: 1.3rem;
      font-weight: 500;
    }
    header span {
      font-size: 0.8rem;
      color: #aaa;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 12px;
      max-width: 1100px;
      margin: 0 auto;
      padding: 20px;
    }
    .item {
      background: #fff;
      border-radius: 6px;
      overflow: hidden;
      border: 1px solid #eee;
      transition: box-shadow 0.15s;
    }
    .item:hover {
      box-shadow: 0 2px 12px rgba(0,0,0,0.1);
    }
    .item img {
      width: 100%;
      height: 160px;
      object-fit: contain;
      background: #f5f5f5;
      display: block;
    }
    .item .label {
      padding: 8px 10px;
      font-size: 0.8rem;
      color: #888;
      text-align: center;
      word-break: break-all;
    }
    .empty {
      text-align: center;
      padding: 80px 20px;
      color: #aaa;
      font-size: 0.95rem;
    }
  </style>
</head>
<body>
  <header>
    <a class="back" href="/">&larr;</a>
    <h1>目录 {dir}</h1>
    <span>{files.length} 张图片</span>
  </header>

  {files.length === 0 ? (
    <div class="empty">此目录暂无图片</div>
  ) : (
    <div class="grid">
      {files.map(f => (
        <div class="item">
          <a href={`${basePath}/${f}`} target="_blank">
            <img src={`${basePath}/${f}`} alt={f} loading="lazy" />
          </a>
          <div class="label">{f}</div>
        </div>
      ))}
    </div>
  )}
</body>
</html>